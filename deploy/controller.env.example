# ==============================================================================
# Main Controller Environment Configuration
# Location on target machine: /etc/osu-stream/controller.env
# Owner and permissions: root:root, chmod 600
# ==============================================================================

# Operation Mode
RUN_MODE=controller

# Buffer settings (ready videos + active rendering jobs)
BUFFER_SIZE=3
DELETE_AFTER_PLAY=true
PRODUCER_ENABLED=true

# Player & Web Control Interface (Local only, proxied by Nginx)
WEB_HOST=127.0.0.1
WEB_PORT=8787
MAX_UPLOAD_MIB=20
MAX_BACKGROUND_MIB=20
PLAYER_VOLUME=20

# Internal Render API (Listen on private WireGuard / VPN IP)
# Do NOT bind to 0.0.0.0 or a public IP!
RENDER_API_HOST=10.10.0.1
RENDER_API_PORT=8790
# Strong secret shared between Controller and Worker (e.g. generate with: openssl rand -hex 32)
RENDER_API_TOKEN=

# Maximum size of one artifact received from a Render Worker.
# Select this according to available controller disk space.
MAX_ARTIFACT_MIB=1024

# Replay Discovery
OSU_REPLAY_URL=https://api.osuokayu.pw/v1/get_replay
OSU_SCORES_URL=https://api.osuokayu.pw/v2/scores
SCORE_ID_MIN=1
SCORE_ID_MAX=0
RANDOM_REPLAY_ATTEMPTS=150

# Discord Intake (Optional)
DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_GUILD_ID=0
DISCORD_CHANNEL_ID=0
DISCORD_QUEUE_LIMIT=50
DISCORD_USER_COOLDOWN_SECONDS=300
DISCORD_MAX_FILE_MIB=10
