[Unit]
Description=osu-stream Controller Service
After=network.target network-online.target
Wants=network-online.target

[Service]
Type=simple
User=osu-stream
Group=osu-stream
WorkingDirectory=/opt/osu-stream-bot
EnvironmentFile=/etc/osu-stream/controller.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStartPre=/opt/osu-stream-bot/venv/bin/python /opt/osu-stream-bot/app.py --check
ExecStart=/opt/osu-stream-bot/venv/bin/python /opt/osu-stream-bot/app.py

Restart=on-failure
RestartSec=5s
UMask=0077

# Process & Resource limits
LimitNOFILE=65536
TimeoutStopSec=30s

# Sandboxing & Security hardening
ProtectSystem=strict
ProtectHome=true
NoNewPrivileges=true
PrivateTmp=true
ReadWritePaths=/opt/osu-stream-bot
CapabilityBoundingSet=
AmbientCapabilities=
LockPersonality=true
ProtectControlGroups=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6

[Install]
WantedBy=multi-user.target
