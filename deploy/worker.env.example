# ==============================================================================
# Render Worker Environment Configuration
# Location on target machine: /etc/osu-stream/worker.env
# Owner and permissions: root:root, chmod 600
# ==============================================================================

# Operation Mode
RUN_MODE=render-worker
WORKER_ID=render-vps-1

# Controller API Connection (over WireGuard / private VPN)
CONTROLLER_RENDER_URL=http://10.10.0.1:8790
# Must exactly match RENDER_API_TOKEN on Controller
RENDER_API_TOKEN=

# Lease & Heartbeat Settings
RENDER_HEARTBEAT_SECONDS=15.0

# Danser Settings
DANSER_DIR=tools/danser
DANSER_SETTINGS=stream-cpu
DANSER_SKINS_DIR=auto
DANSER_SKIN=default
DANSER_RANDOM_SKIN=false
DANSER_USE_SKIN_CURSOR=true
DANSER_REPLAY_OVERLAY=true
DANSER_BACKGROUND_DIM_PERCENT=95
DANSER_PARALLAX_ENABLED=true
DANSER_PARALLAX_AMOUNT_PERCENT=10
DANSER_PARALLAX_SPEED_PERCENT=50
DANSER_RENDER_TIMEOUT_SECONDS=3600
DANSER_MAX_MAP_MIB=300
DANSER_MAX_SONGS_MIB=5120
