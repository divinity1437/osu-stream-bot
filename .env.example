# Operation Mode: "standalone" (all-in-one local), "controller" (web/queue/API), or "render-worker" (danser rendering worker).
RUN_MODE=standalone

# Renderer backend: "ordr" for the hosted service or "danser" for local rendering.
RENDER_BACKEND=ordr

# o!rdr: keep this enabled while testing. It creates simulated jobs only.
ORDR_DEVELOPER_MODE=true

# Ask masterioo on Discord for a bot key, then put it here and disable developer mode.
ORDR_API_KEY=
ORDR_SKIN=whitecatCK1.0
ORDR_CUSTOM_SKIN=false
ORDR_DT_SKIN=RafisHDDT2018-03-26
ORDR_DT_CUSTOM_SKIN=false
ORDR_RESOLUTION=1280x720
ORDR_RENDER_TIMEOUT_SECONDS=1800

# Without an API key o!rdr permits only one request every five minutes.
# 0 selects 305 seconds without a key and 5 seconds with a key.
ORDR_MIN_SUBMIT_INTERVAL_SECONDS=0

OSU_REPLAY_URL=https://api.osuokayu.pw/v1/get_replay
OSU_SCORES_URL=https://api.osuokayu.pw/v2/scores
SCORE_ID_MIN=1
# Leave at 0 to discover the newest score through /v2/scores.
SCORE_ID_MAX=0
RANDOM_REPLAY_ATTEMPTS=150

# Includes the currently playing file. Two means one playing and one ready.
BUFFER_SIZE=2
DELETE_AFTER_PLAY=true
PRODUCER_ENABLED=true

WEB_HOST=127.0.0.1
WEB_PORT=8787
MAX_UPLOAD_MIB=20
# Temporary /control waiting-background upload limit. The file is never persisted.
MAX_BACKGROUND_MIB=20
PLAYER_VOLUME=20

# Local danser backend. Run ./install-danser.sh once before selecting it.
DANSER_DIR=tools/danser
DANSER_SETTINGS=stream-cpu
# "auto" detects common osu!stable/Wine skin folders. An explicit path is also accepted.
DANSER_SKINS_DIR=auto
DANSER_SKIN=default
DANSER_RANDOM_SKIN=false
DANSER_USE_SKIN_CURSOR=true
DANSER_REPLAY_OVERLAY=true
DANSER_BACKGROUND_DIM_PERCENT=95
DANSER_PARALLAX_ENABLED=true
DANSER_PARALLAX_AMOUNT_PERCENT=10
DANSER_PARALLAX_SPEED_PERCENT=50
DANSER_RENDER_TIMEOUT_SECONDS=3600
DANSER_MAX_MAP_MIB=300
DANSER_MAX_SONGS_MIB=5120

# Discord replay intake. Keep the token only in .env, never commit or post it.
DISCORD_ENABLED=false
DISCORD_TOKEN=
DISCORD_GUILD_ID=0
DISCORD_CHANNEL_ID=0
DISCORD_QUEUE_LIMIT=50
DISCORD_USER_COOLDOWN_SECONDS=300
DISCORD_MAX_FILE_MIB=10

# Multi-node Controller & Render Worker Settings (Required when RUN_MODE is "controller" or "render-worker")
# Shared secret for authenticating Render Workers to the Controller. Generate with: openssl rand -hex 32
RENDER_API_TOKEN=
# Controller Internal Render API: Host & Port for workers to connect to
RENDER_API_HOST=127.0.0.1
RENDER_API_PORT=8790
# Maximum size in MiB for rendered artifacts uploaded by workers to the controller
MAX_ARTIFACT_MIB=1024

# Worker-specific Settings (when RUN_MODE=render-worker)
# URL of the Controller API (e.g. http://127.0.0.1:8790 or private WireGuard IP)
CONTROLLER_URL=
# Unique identifier for this worker instance (default: worker-<hostname>)
WORKER_ID=
# Heartbeat interval in seconds to refresh lease during rendering (1..20)
RENDER_HEARTBEAT_SECONDS=15.0
