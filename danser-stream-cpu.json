{
  "General": {
    "OsuSongsDir": "songs",
    "OsuSkinsDir": "skins",
    "OsuReplaysDir": "replays",
    "DiscordPresenceOn": false,
    "UnpackOszFiles": false,
    "VerboseImportLogs": false
  },
  "Graphics": {
    "Width": 1280,
    "Height": 720,
    "WindowWidth": 1280,
    "WindowHeight": 720,
    "Fullscreen": false,
    "VSync": false,
    "FPSCap": 0,
    "MSAA": 0,
    "ShowFPS": false
  },
  "Skin": {
    "CurrentSkin": "default",
    "FallbackSkin": "default",
    "UseColorsFromSkin": false,
    "UseBeatmapColors": false,
    "Cursor": {
      "UseSkinCursor": true
    }
  },
  "Playfield": {
    "LeadInTime": 0,
    "LeadInHold": 0,
    "FadeOutTime": 2,
    "SeizureWarning": {
      "Enabled": false,
      "Duration": 0
    },
    "Background": {
      "LoadStoryboards": false,
      "LoadVideos": false,
      "Dim": {
        "Intro": 0,
        "Normal": 0.95,
        "Breaks": 0.5
      },
      "Parallax": {
        "Enabled": true,
        "Amount": 0.1,
        "Speed": 0.5
      }
    },
    "Logo": {
      "Enabled": false,
      "DrawSpectrum": false
    },
    "Bloom": {
      "Enabled": false
    }
  },
  "Gameplay": {
    "ScoreBoard": {
      "Show": false,
      "ShowAvatars": false
    },
    "ShowResultsScreen": true,
    "ResultsScreenTime": 5,
    "AlwaysSkipIntro": true,
    "Statistics": [
      {
        "Show": true,
        "Template": "{{formatF 2 .stars}}★  •  {{.name}}  •  {{if .modsA}}{{.modsA}}{{else}}NM{{end}}",
        "XPosition": 0,
        "YPosition": 16,
        "Align": "Top",
        "Anchor": "Top",
        "Size": 24,
        "Opacity": 1,
        "Color": {
          "Hue": 0,
          "Saturation": 0,
          "Value": 1
        }
      }
    ]
  },
  "Recording": {
    "FrameWidth": 1280,
    "FrameHeight": 720,
    "FPS": 60,
    "EncodingFPSCap": 0,
    "Encoder": "libx264",
    "libx264": {
      "RateControl": "crf",
      "Bitrate": "10M",
      "CRF": 20,
      "Profile": "high",
      "Preset": "veryfast",
      "AdditionalOptions": ""
    },
    "PixelFormat": "yuv420p",
    "Filters": "",
    "AudioCodec": "aac",
    "aac": {
      "Bitrate": "192k",
      "AdditionalOptions": ""
    },
    "AudioFilters": "",
    "OutputDir": "videos",
    "Container": "mp4",
    "ShowFFmpegLogs": false,
    "MotionBlur": {
      "Enabled": false,
      "OversampleMultiplier": 1,
      "BlendFrames": 1,
      "BlendFunctionID": 0,
      "GaussWeightsMult": 1
    }
  }
}
